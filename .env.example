# cube-entity overlay configuration. Copy to .env or ~/.config/cube/config.
# All values optional — sensible defaults shipped in the scripts.

# ─── mock-cube backend bind ──────────────────────────────────────────────
# 0.0.0.0 exposes mock-cube to the Windows-host overlay across the WSL-IP
# boundary. 127.0.0.1 keeps it WSL-local (CLI testing only).
#CUBE_MOCK_HOST=0.0.0.0
#CUBE_MOCK_PORT=8765

# ─── ccusage 5h-window quota ─────────────────────────────────────────────
# Anthropic does not publish exact Max-plan token limits. Override here to
# match the value the web dashboard shows. Empty = use ccusage's
# historical-max heuristic (usually too high for Max(5x)).
#CUBE_USAGE_TOKEN_LIMIT=155000000

# Explicit ccusage invocation. Empty = auto-resolve via npx-in-PATH then ~/.nvm.
#CUBE_CCUSAGE_CMD=

# ─── state machine tuning ────────────────────────────────────────────────
# Transient-state revert delays. 0 = stay forever (overlay shows until next state).
#CUBE_ALERT_REVERT=5
#CUBE_PERMISSION_REVERT=5
#CUBE_ERROR_REVERT=5
#CUBE_COMPACT_REVERT=5
#CUBE_DONE_REVERT=5
#CUBE_START_REVERT=5

# Defer Bash failures by N seconds. Cancelled if Claude retries successfully
# in the same turn. 0 = immediate error display.
#CUBE_ERROR_GRACE=3

# Suppress the `done` blip Stop fires right after PreCompact's recap message.
# 0 = disable suppression.
#CUBE_RECAP_WINDOW=60

# Stale-session prune timeouts.
#CUBE_SESSION_TTL=3600
#CUBE_IDLE_TTL=600
