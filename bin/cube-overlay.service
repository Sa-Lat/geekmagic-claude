[Unit]
Description=Cube overlay — frameless Tk window mirroring mock-cube state
After=mock-cube.service
Requires=mock-cube.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
EnvironmentFile=-%h/.config/cube/overlay.env
ExecStart=/usr/bin/python3 %h/.claude/bin/cube-overlay.py --frameless
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
