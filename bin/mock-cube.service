[Unit]
Description=Cube-entity backend — local HTTP aggregator for the overlay

[Service]
Type=simple
EnvironmentFile=-%h/.config/cube/config
ExecStart=/usr/bin/python3 %h/.claude/bin/mock-cube.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
