[Unit]
Description=Mock Geekmagic cube — local HTTP server for cube-overlay
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.claude/bin/mock-cube.py --assets %h/projects/cube/assets
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
